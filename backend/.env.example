# PostgreSQL. Sustituir CAMBIAR por la contraseña del rol decibelcity.
DECIBELCITY_DATABASE_URL=postgresql://decibelcity:CAMBIAR@127.0.0.1:5432/decibelcity
DECIBELCITY_DATABASE_SCHEMA=public
# Base separada; las pruebas crean y eliminan únicamente esquemas test_<UUID>.
DECIBELCITY_TEST_DATABASE_URL=postgresql://decibelcity:CAMBIAR@127.0.0.1:5432/decibelcity_test
# Orígenes separados por coma; sin barra final.
DECIBELCITY_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Mapas: OpenStreetMap no necesita claves. Estas variables son opcionales;
# solo cambiarlas para usar servidores propios (ver Documentacion/mapas-openstreetmap.md).
# DECIBELCITY_NOMINATIM_URL=https://nominatim.openstreetmap.org
# DECIBELCITY_PHOTON_URL=https://photon.komoot.io
# DECIBELCITY_GEOCODER_USER_AGENT=DecibelCity/0.1 (prototipo educativo de reportes de ruido)
# DECIBELCITY_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
